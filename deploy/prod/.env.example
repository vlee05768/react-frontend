IMAGE_HUB_URL=registry.example.invalid/replace-with-project
FRONTEND_IMAGE_TAG=replace-with-release-tag
FRONTEND_PORT=8088

POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-strong-database-password
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=postgres;Port=5432;Database=replace-with-database-name;Username=replace-with-database-user;Password=replace-with-database-password

JWTSETTINGS__SECRETKEY=replace-with-long-random-jwt-secret
JWTSETTINGS__ISSUER=replace-with-jwt-issuer
JWTSETTINGS__AUDIENCE=replace-with-jwt-audience
JWTSETTINGS__EXPIRYMINUTES=60

EMAILSETTINGS__SMTPSERVER=replace-with-smtp-server
EMAILSETTINGS__PORT=2525
EMAILSETTINGS__ENABLESSL=replace-with-true-or-false
EMAILSETTINGS__USEAUTHENTICATION=true
EMAILSETTINGS__SENDACTIVATIONEMAILONCREATE=true
EMAILSETTINGS__USERNAME=replace-with-smtp-username
EMAILSETTINGS__PASSWORD=replace-with-smtp-password
EMAILSETTINGS__DEFAULTSENDER=replace-with-sender-address
EMAILSETTINGS__DEFAULTSENDERNAME=replace-with-sender-name
CORS__ALLOWEDORIGINS=https://replace-with-frontend-host
FRONTENDHOMEURL=https://replace-with-frontend-host

MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-strong-minio-secret-key
MINIO_BUCKET=replace-with-bucket-name
MINIO_USESSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
